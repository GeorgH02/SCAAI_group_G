erDiagram
    %% Application tables live in database vienna_stay, schema vienna_stay_assistant.
    %% Five source tables and ingestion_runs are implemented by 20-schema.sql and data_setup/load_sql.py.
    %% Noise zones/bands and BM25 below remain planned; no noise data is loaded.
    ingestion_runs ||--o{ neighbourhoods : provenance
    ingestion_runs ||--o{ hosts : provenance
    ingestion_runs ||--o{ listings : provenance
    ingestion_runs ||--o{ reviews : provenance
    ingestion_runs ||--o{ calendar : provenance
    neighbourhoods ||--o{ listings : contains
    hosts ||--o{ listings : owns
    listings ||--o{ reviews : receives
    listings ||--o{ calendar : "has availability"
    listings }o..o{ noise_zones : "spatial join (150 m buffer)"

    neighbourhoods {
        string neighbourhood PK
        int district_number
        geometry geometry
    }

    hosts {
        bigint host_id PK
        string host_name "fixed placeholder"
        text host_about "masked; search planned"
        boolean host_is_superhost
        date host_since
        int host_listings_count
        float host_response_rate
    }

    listings {
        bigint listing_id PK
        bigint host_id FK
        string neighbourhood FK
        text name "masked; search planned"
        text description "masked; dense indexed separately"
        text neighborhood_overview "masked; search planned"
        string room_type
        int accommodates
        numeric bedrooms
        numeric price "base price at snapshot"
        text_array amenities
        float review_scores_rating "plus sub-scores"
        float latitude
        float longitude
        geography location "generated WGS84 point"
        string lnight_road_band "derived"
        string lnight_rail_band "derived"
    }

    reviews {
        bigint review_id PK
        bigint listing_id FK
        date date
        text comments "masked; dense indexed separately"
        string language
    }

    calendar {
        bigint listing_id PK, FK
        date date PK
        boolean available
        int minimum_nights
        int maximum_nights
    }

    noise_zones {
        int zone_id PK
        string source "road or rail"
        string indicator "Lnight"
        string db_band
        geometry geometry
    }

    ingestion_runs {
        uuid load_id PK
        date snapshot_date
        timestamptz completed_at
        jsonb config "source hashes and settings"
        jsonb validation "committed validation report"
    }
